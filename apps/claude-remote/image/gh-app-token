#!/usr/bin/env bash
# Prints a GitHub App installation token (valid 1 h), cached in /tmp and renewed
# 5 min before expiry. Needs GH_APP_ID, GH_INSTALLATION_ID and
# GH_APP_PRIVATE_KEY_B64 (base64 of the app's .pem) from the claude-session
# Secret. `gh-app-token --jwt` prints a short-lived app JWT instead.
set -euo pipefail

: "${GH_APP_ID:?}" "${GH_INSTALLATION_ID:?}" "${GH_APP_PRIVATE_KEY_B64:?}"
cache=/tmp/gh-app-token.json

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

jwt() {
  local now key header payload sig
  now=$(date +%s)
  key=$(mktemp); trap 'rm -f "$key"' RETURN
  base64 -d <<<"$GH_APP_PRIVATE_KEY_B64" > "$key"
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$GH_APP_ID" | b64url)
  sig=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$key" -binary | b64url)
  printf '%s.%s.%s' "$header" "$payload" "$sig"
}

if [[ "${1:-}" == "--jwt" ]]; then jwt; exit; fi

if [[ -s "$cache" ]]; then
  exp=$(date -d "$(jq -r .expires_at "$cache")" +%s 2>/dev/null || echo 0)
  if (( exp - $(date +%s) > 300 )); then jq -r .token "$cache"; exit; fi
fi

resp=$(curl -fsS -X POST \
  -H "Authorization: Bearer $(jwt)" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/app/installations/${GH_INSTALLATION_ID}/access_tokens")
umask 077
jq '{token, expires_at}' <<<"$resp" > "$cache"
jq -r .token "$cache"
